<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Склад тканей</title>
<style>
  html, body { height: 100%; margin: 0; }
  body { display: grid; place-items: center; background: #eceee8; color: #4a5060; font: 16px/1.4 system-ui, "Segoe UI", Arial, sans-serif; }
  .box { text-align: center; padding: 24px; }
  .spin { width: 34px; height: 34px; margin: 0 auto 14px; border: 3px solid #c9ccd4; border-top-color: #2f3fb5; border-radius: 50%; animation: s 0.8s linear infinite; }
  @keyframes s { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<div class="box"><div class="spin" id="sp"></div><p id="m">Загружаю программу…</p></div>
<script src="config.js"></script>
<script>
/* Запускалка для компьютера: берёт последнюю версию программы с сервера (её публикует сборка на GitHub),
   поэтому обновлять ничего не нужно. Без интернета открывает версию, загруженную в прошлый раз. */
(function () {
  var C = window.SKLAD_CONFIG || {}, base = String(C.url || "").replace(/\/+$/, "");
  var KEY = "sklad_pc_html";
  function run(html) {
    try { localStorage.setItem(KEY, html); } catch (e) {}
    document.open(); document.write(html); document.close();
  }
  function fallback(msg) {
    var h = null; try { h = localStorage.getItem(KEY); } catch (e) {}
    if (h) { run(h); return; }
    document.getElementById("sp").style.display = "none";
    document.getElementById("m").textContent = msg;
  }
  if (!base) { fallback("Нет файла config.js рядом с этим файлом."); return; }
  fetch(base + "/storage/v1/object/public/app/index-latest.html?t=" + Date.now(), { cache: "no-store" })
    .then(function (r) { if (!r.ok) throw new Error(r.status); return r.text(); })
    .then(function (t) { if (t.indexOf("APP_VERSION") === -1) throw new Error("bad"); run(t); })
    ["catch"](function () { fallback("Нет связи с сервером. Проверьте интернет и откройте файл снова."); });
})();
</script>
</body>
</html>
